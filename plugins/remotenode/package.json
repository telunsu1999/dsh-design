{
  "name": "@dsh-design/remotenode",
  "version": "0.1.0",
  "private": true,
  "description": "Remote Node plugin for DeepSeek Harness: peer links between DSH instances, remote sessions with origin markers, and bidirectional deliverable sync.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "SPEC.md"
  ],
  "engines": {
    "dsh": ">=0.1.0-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/telunsu1999/dsh-design.git",
    "directory": "plugins/remotenode"
  },
  "homepage": "https://github.com/telunsu1999/dsh-design/tree/main/plugins/remotenode#readme"
}
